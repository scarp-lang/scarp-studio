{
  "name": "scarp-studio",
  "private": true,
  "version": "0.0.2-alpha.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tauri": "tauri",
    "check:release-candidate": "node scripts/check-release-candidate.mjs",
    "test:release-candidate": "node --test scripts/check-release-candidate.node-tests.mjs scripts/windows-acceptance-report.node-tests.mjs scripts/settings-browser-harness.node-tests.mjs",
    "test:settings-browser": "node scripts/settings-browser-smoke.mjs",
    "test:search-browser": "vite build --config vite.search-smoke.config.ts && node scripts/search-browser-smoke.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "monaco-editor": "^0.52.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
