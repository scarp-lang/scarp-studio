{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "studio-main",
  "description": "User-selected Scarp source files only; no shell or unrestricted filesystem scope.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "fs:allow-read-dir",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:deny-default"
  ]
}
